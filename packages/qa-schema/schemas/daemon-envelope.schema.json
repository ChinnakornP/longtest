{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa.local/schema/daemon-envelope/1",
  "x-contract-version": "1.0.0",
  "title": "Daemon control-plane envelope",
  "description": "Contract D. Every frame on the single outbound WebSocket between a runtime daemon and the backend. Delivery is at-least-once and the server deduplicates on (runId, seq), so seq is part of the envelope rather than the payload.",
  "$ref": "#/$defs/Envelope",
  "$defs": {
    "Envelope": {
      "type": "object",
      "required": ["v", "type", "msgId", "seq", "ts", "payload"],
      "properties": {
        "v": { "const": 1 },
        "type": {
          "enum": [
            "hello",
            "heartbeat",
            "run.assign",
            "run.cancel",
            "run.event",
            "run.result"
          ]
        },
        "msgId": { "type": "string", "format": "uuid" },
        "runId": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "Required for every run.* frame, null or absent for hello and heartbeat."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic per (connection, runId). The server deduplicates on (runId, seq)."
        },
        "ts": { "type": "string", "format": "date-time" },
        "payload": {
          "type": "object",
          "x-go-type": "json.RawMessage",
          "x-ts-type": "unknown",
          "$comment": "Kept raw by the generated types: decode type first, then decode payload into the matching *Payload type."
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "hello" } } },
          "then": { "$ref": "#/$defs/HelloFrame" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "heartbeat" } } },
          "then": { "$ref": "#/$defs/HeartbeatFrame" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "run.assign" } } },
          "then": { "$ref": "#/$defs/RunAssignFrame" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "run.cancel" } } },
          "then": { "$ref": "#/$defs/RunCancelFrame" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "run.event" } } },
          "then": { "$ref": "#/$defs/RunEventFrame" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "run.result" } } },
          "then": { "$ref": "#/$defs/RunResultFrame" }
        }
      ]
    },

    "RunScopedFrame": {
      "x-codegen": "skip",
      "type": "object",
      "required": ["runId"],
      "properties": { "runId": { "type": "string", "format": "uuid" } }
    },
    "RuntimeScopedFrame": {
      "x-codegen": "skip",
      "type": "object",
      "properties": { "runId": { "type": "null" } }
    },

    "HelloFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RuntimeScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/HelloPayload" }
          }
        }
      ]
    },
    "HeartbeatFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RuntimeScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/HeartbeatPayload" }
          }
        }
      ]
    },
    "RunAssignFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RunScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/RunAssignPayload" }
          }
        }
      ]
    },
    "RunCancelFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RunScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/RunCancelPayload" }
          }
        }
      ]
    },
    "RunEventFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RunScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/RunEventPayload" }
          }
        }
      ]
    },
    "RunResultFrame": {
      "x-codegen": "skip",
      "allOf": [
        { "$ref": "#/$defs/RunScopedFrame" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": true,
            "type": true,
            "msgId": true,
            "runId": true,
            "seq": true,
            "ts": true,
            "payload": { "$ref": "#/$defs/RunResultPayload" }
          }
        }
      ]
    },

    "HelloPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId", "version", "browsers", "agents"],
      "properties": {
        "runtimeId": { "type": "string", "format": "uuid" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "hostname": { "type": "string", "maxLength": 255 },
        "os": { "enum": ["linux", "darwin", "windows"] },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["chromium", "firefox", "webkit"] }
        },
        "agents": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/AgentCapability" }
        }
      },
      "$comment": "The org a daemon belongs to is derived from its runtime token, never from this payload."
    },

    "AgentCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok"],
      "properties": {
        "name": { "enum": ["claude", "opencode", "antigravity"] },
        "version": { "type": "string", "maxLength": 64 },
        "ok": { "type": "boolean" },
        "error": { "type": "string", "maxLength": 1000 }
      }
    },

    "HeartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uptimeSec"],
      "properties": {
        "uptimeSec": { "type": "integer", "minimum": 0 },
        "activeRuns": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },

    "RunAssignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "mode", "projectId", "baseUrl", "artifactUpload"],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "mode": { "enum": ["discover", "plan", "execute", "full"] },
        "projectId": { "type": "string", "format": "uuid" },
        "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "agent": { "enum": ["claude", "opencode", "antigravity"] },
        "appMap": { "$ref": "https://qa.local/schema/application-map/1#/$defs/ApplicationMap" },
        "testCases": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "https://qa.local/schema/test-case/1#/$defs/TestCase" }
        },
        "artifactUpload": { "$ref": "#/$defs/ArtifactUpload" }
      }
    },

    "ArtifactUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presignedPutBase", "keyPrefix", "expiresAt"],
      "properties": {
        "presignedPutBase": { "type": "string", "format": "uri", "maxLength": 2048 },
        "keyPrefix": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^orgs/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/runs/[0-9]{4}-[0-9]{2}-[0-9]{2}/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/$",
          "description": "The daemon may only write below this prefix; the presigned policy enforces the same bound server-side. Segments are anchored the same way as Artifact.key: a prefix whose run segment could be \"..\" is not a bound."
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },

    "RunCancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "enum": ["user_requested", "timeout", "superseded", "shutdown"] },
        "message": { "type": "string", "maxLength": 1000 }
      }
    },

    "RunEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "level", "code", "message"],
      "properties": {
        "phase": { "enum": ["discover", "plan", "execute", "analyze", "report"] },
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Machine-readable event code, e.g. page_discovered or agent_output_invalid. The UI switches on this, never on message."
        },
        "message": { "type": "string", "maxLength": 4000 },
        "testCaseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "data": {
          "type": "object",
          "description": "Free-form structured detail for this code. Anything lifted off the page under test lands here as data, never as message."
        }
      }
    },

    "RunResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["completed", "failed", "cancelled"] },
        "error": { "$ref": "#/$defs/RunError" },
        "appMap": { "$ref": "https://qa.local/schema/application-map/1#/$defs/ApplicationMap" },
        "testPlan": { "$ref": "https://qa.local/schema/test-plan/1#/$defs/TestPlan" },
        "executions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "https://qa.local/schema/execution-result/1#/$defs/ExecutionResult"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "https://qa.local/schema/finding/1#/$defs/Finding" }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "https://qa.local/schema/execution-result/1#/$defs/Artifact" }
        }
      }
    },

    "RunError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "agent_output_invalid",
            "agent_not_available",
            "browser_launch_failed",
            "target_unreachable",
            "artifact_upload_failed",
            "internal"
          ]
        },
        "message": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
