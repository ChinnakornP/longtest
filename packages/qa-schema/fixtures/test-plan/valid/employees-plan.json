{
  "version": 1,
  "projectId": "018f3a8c-2b7e-7c31-9f4a-6f0f1c2d3e4b",
  "sourceAppMapRunId": "018f3a90-11a2-7000-8000-0123456789ab",
  "testCases": [
    {
      "version": 1,
      "id": "TC-001",
      "name": "Create employee",
      "priority": "critical",
      "category": "functional",
      "preconditions": [
        "fixture:logged_in_as_admin"
      ],
      "steps": [
        {
          "action": "navigate",
          "url": "/employees"
        },
        {
          "action": "click",
          "target": {
            "ref": "emp.btn.add"
          }
        },
        {
          "action": "fill",
          "target": {
            "ref": "emp.form.firstName"
          },
          "value": "John"
        },
        {
          "action": "click",
          "target": {
            "ref": "emp.btn.save"
          }
        },
        {
          "action": "waitFor",
          "target": {
            "ref": "emp.toast.success"
          },
          "state": "visible",
          "timeoutMs": 5000
        }
      ],
      "assertions": [
        {
          "type": "visible",
          "target": {
            "ref": "emp.toast.success"
          }
        },
        {
          "type": "textContains",
          "target": {
            "ref": "emp.table"
          },
          "value": "John"
        },
        {
          "type": "urlMatches",
          "value": "^/employees/[0-9]+$"
        },
        {
          "type": "httpStatusNot",
          "value": 500
        }
      ]
    },
    {
      "version": 1,
      "id": "TC-014",
      "name": "Login rejects a wrong password",
      "description": "The failure path has to stay on /login and must not leak a stack trace to the console.",
      "priority": "high",
      "category": "validation",
      "status": "approved",
      "tags": [
        "auth",
        "negative"
      ],
      "steps": [
        {
          "action": "navigate",
          "url": "/login",
          "waitUntil": "domcontentloaded"
        },
        {
          "action": "fill",
          "target": {
            "ref": "login.input.email"
          },
          "value": "admin@example.test"
        },
        {
          "action": "fill",
          "target": {
            "ref": "login.input.password"
          },
          "value": "not-the-password"
        },
        {
          "action": "press",
          "target": {
            "ref": "login.input.password"
          },
          "key": "Enter"
        },
        {
          "action": "screenshot",
          "name": "after-failed-login",
          "fullPage": true
        }
      ],
      "assertions": [
        {
          "type": "visible",
          "target": {
            "ref": "login.error.banner"
          }
        },
        {
          "type": "urlMatches",
          "value": "^/login"
        },
        {
          "type": "noConsoleError",
          "ignorePatterns": [
            "favicon"
          ]
        }
      ]
    }
  ],
  "rationale": "The employee list is the only place in the map with a create/edit/delete workflow, so it carries most of the product risk. Login is covered on the negative path only: the positive path is already a precondition of every other case, so a regression there would fail the whole suite loudly.",
  "coverageNotes": "Not covered: pagination beyond page 1 (the map found no pager), the bulk-import dialog (reachable only from a menu the crawler could not open) and anything behind /admin (the discovery run had no credentials for it)."
}
