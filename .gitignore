# ---- secrets: never commit real values ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kubeconfig
secrets/

# ---- runtime state / agent workspaces ----
# QA runs write untrusted page content + target-app evidence here.
# Anchored to the repo root: `daemon/artifacts/` and `daemon/workspace/` are
# source directories, not run output.
/workspaces/
/artifacts/
/.qa-runtime/

# ---- node ----
node_modules/
.next/
out/
dist/
build/
# vitest --coverage writes to a `coverage/` dir at each package root (see the
# per-package vitest.config.ts files) - anchored per package instead of a bare
# `coverage/` so it can't shadow a source path with that name anywhere else in
# the tree, e.g. apps/web/src/app/.../coverage/*.tsx (see LONG-18's PR #20).
/apps/*/coverage/
/packages/*/coverage/
/daemon/*/coverage/
*.tsbuildinfo
.eslintcache
.turbo/
.pnpm-store/

# ---- go ----
/bin/
*.test
*.out

# ---- playwright ----
test-results/
playwright-report/
blob-report/
.playwright/

# ---- editors / os ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by `go get` / `go mod tidy` in workspace mode. Every dependency is
# already pinned in a module's own go.sum, so this adds nothing but churn.
go.work.sum
