# ---------------------------------------------------------------------------
# Local development defaults. Copy to `.env` (git-ignored) and `make up`.
#
#   cp .env.example .env
#
# These values are LOCAL-DEV-ONLY placeholders. Every service started by
# docker-compose.yml binds to 127.0.0.1 only, so nothing here is reachable
# from the LAN. Never reuse these values outside your machine and never
# commit a filled-in `.env` — this repository is PUBLIC.
# Real environments get their values from a secret manager (see T12).
# ---------------------------------------------------------------------------

# ---- shared ----
COMPOSE_PROJECT_NAME=qa
# Host interface every published port binds to. Keep 127.0.0.1.
# Changing this to 0.0.0.0 exposes the database and object store to your
# whole network — the QA daemon is meant to run inside customer networks.
BIND_HOST=127.0.0.1

# ---- postgres ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=qa
POSTGRES_USER=qa
POSTGRES_PASSWORD=local-dev-only-change-me
# Consumed by server/cmd/{server,migrate,seed}. Host/port must match the values above.
DATABASE_URL=postgres://qa:local-dev-only-change-me@127.0.0.1:5432/qa?sslmode=disable
# Server for the database-backed Go tests. They CREATE and DROP their own
# throwaway database on it, so point it at a local server only. Unset means
# those tests skip; `make test-db` falls back to DATABASE_URL.
TEST_DATABASE_URL=postgres://qa:local-dev-only-change-me@127.0.0.1:5432/qa?sslmode=disable
# Password for the dev owner account created by `make seed`. Deliberately blank:
# the seed refuses to run rather than fall back to a default, so no credential
# can ever ship from this file.
SEED_OWNER_PASSWORD=

# Origin a DAEMON reaches this API on. It is embedded in every run.assign frame
# as the base of the artifact upload endpoint, so it has to resolve from inside
# the customer's network, not just from this process. Defaults to
# http://$SERVER_HTTP_ADDR, which is right for local development only.
SERVER_PUBLIC_URL=http://127.0.0.1:8080
# How long a runtime stays "online" after its last heartbeat. Past this it is
# reported offline and the runs it was holding are finished with a reason.
RUNTIME_ONLINE_WITHIN=30s
# How many times a run may be handed to a runtime before a lost daemon finishes
# it as an error instead of requeueing it. 1 means "never silently re-run
# somebody's application", which is the right default for a tool that clicks
# buttons in production-shaped systems.
RUN_MAX_ATTEMPTS=1

# ---- minio (S3-compatible artifact store) ----
MINIO_ROOT_USER=qa-local-root
MINIO_ROOT_PASSWORD=local-dev-only-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=qa-artifacts
S3_ACCESS_KEY_ID=qa-local-root
S3_SECRET_ACCESS_KEY=local-dev-only-change-me
# Address the bucket as {endpoint}/{bucket}/{key}. Required by MinIO and by any
# endpoint that is a bare IP; turn it off only for real AWS S3.
S3_PATH_STYLE=true
# Endpoint a DAEMON can reach, when it differs from the one the backend uses
# (a compose network name vs. the developer's machine). Empty means the same.
S3_PUBLIC_ENDPOINT=
# Presigned PUT lifetime handed to the daemon for artifact upload. It has to
# outlive a slow upload of a multi-megabyte trace over a customer's uplink.
S3_PRESIGN_TTL=15m
# How long after assignment a run may keep minting upload URLs. Capped at 6h.
S3_UPLOAD_WINDOW=6h
# Object store for the opt-in live presign test (internal/artifact, `-run Live`).
# It uploads one small object to a throwaway key. Unset means that test skips.
TEST_S3_ENDPOINT=
TEST_S3_BUCKET=
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=

# ---- backend ----
SERVER_HTTP_ADDR=127.0.0.1:8080
SERVER_LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser. Exact match:
# "*" is not supported, because the session is a credentialed cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Ceiling on a single REST request. The handler context is cancelled at this
# point, which is what stops a slow query holding a pool connection.
SERVER_REQUEST_TIMEOUT=30s

# ---- session cookie ----
# Secure defaults to TRUE. Local development is served over plain http, where a
# browser silently DROPS a Secure cookie - so login would appear to do nothing.
# Never set this to false in a deployment that is reachable over the network.
SESSION_COOKIE_SECURE=false
# Absolute session lifetime. There is no sliding renewal: a stolen cookie is
# usable for at most this long.
SESSION_TTL=168h
# Leave empty for a host-only cookie. Set it only when the API and the web app
# are on different subdomains of the same site.
SESSION_COOKIE_DOMAIN=

# ---- daemon ----
# Pairing token issued per runtime by the backend. Placeholder only.
DAEMON_PAIRING_TOKEN=replace-me-with-a-runtime-pairing-token
DAEMON_SERVER_URL=ws://127.0.0.1:8080/api/v1/daemon
DAEMON_WORKSPACE_ROOT=./workspaces

# ---- target-app credential fixtures ----
# Key the daemon seals target-application logins under (AES-256-GCM), as 32
# base64 bytes. The backend stores only the ciphertext, so this key must NOT
# live wherever that ciphertext does — a dump of both is a dump of the
# credentials. Generate one with:
#
#   head -c 32 /dev/urandom | base64
#
# Deliberately blank: the daemon refuses to seal or open a fixture store
# without it rather than falling back to a default, so no key can ever ship
# from this file. Leaving it unset only disables fixtures, not the run.
QA_FIXTURE_KEY=

# ---- egress ----
# Proxy every sandboxed process is pointed at when a run uses the `proxy`
# network policy. Deny-by-default lives in the proxy, not in the client; see
# the "Known gaps" table in docs/SECURITY.md for what that does and does not
# currently enforce.
QA_EGRESS_PROXY_URL=

# Set to 1 only on a runtime that cannot enforce the process sandbox (macOS,
# Windows). The daemon reports it in `hello` so the platform can refuse to
# schedule production runs there. Never set it on Linux to work around a
# Landlock error - that error means the confinement is not in place.
QA_ALLOW_UNSANDBOXED=0

# ---- web ----
# Leave unset for local dev: apps/web falls back to its own origin, which is
# where the T07 mock backend (apps/web/src/app/api/v1/**) lives. Set this
# once T05 (server/internal/{auth,org}) is up and the mock is removed - the
# web production build requires it (see docs/adr/0008-web-ships-no-backend.md).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
