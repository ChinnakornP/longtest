# ---------------------------------------------------------------------------
# Local development defaults. Copy to `.env` (git-ignored) and `make up`.
#
#   cp .env.example .env
#
# These values are LOCAL-DEV-ONLY placeholders. Every service started by
# docker-compose.yml binds to 127.0.0.1 only, so nothing here is reachable
# from the LAN. Never reuse these values outside your machine and never
# commit a filled-in `.env` — this repository is PUBLIC.
# Real environments get their values from a secret manager (see T12).
# ---------------------------------------------------------------------------

# ---- shared ----
COMPOSE_PROJECT_NAME=qa
# Host interface every published port binds to. Keep 127.0.0.1.
# Changing this to 0.0.0.0 exposes the database and object store to your
# whole network — the QA daemon is meant to run inside customer networks.
BIND_HOST=127.0.0.1

# ---- postgres ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=qa
POSTGRES_USER=qa
POSTGRES_PASSWORD=local-dev-only-change-me
# Consumed by server/cmd/{server,migrate,seed}. Host/port must match the values above.
DATABASE_URL=postgres://qa:local-dev-only-change-me@127.0.0.1:5432/qa?sslmode=disable
# Server for the database-backed Go tests. They CREATE and DROP their own
# throwaway database on it, so point it at a local server only. Unset means
# those tests skip; `make test-db` falls back to DATABASE_URL.
TEST_DATABASE_URL=postgres://qa:local-dev-only-change-me@127.0.0.1:5432/qa?sslmode=disable
# Password for the dev owner account created by `make seed`. Deliberately blank:
# the seed refuses to run rather than fall back to a default, so no credential
# can ever ship from this file.
SEED_OWNER_PASSWORD=

# ---- minio (S3-compatible artifact store) ----
MINIO_ROOT_USER=qa-local-root
MINIO_ROOT_PASSWORD=local-dev-only-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=qa-artifacts
S3_ACCESS_KEY_ID=qa-local-root
S3_SECRET_ACCESS_KEY=local-dev-only-change-me
# Presigned PUT lifetime handed to the daemon for artifact upload.
S3_PRESIGN_TTL=15m

# ---- backend ----
SERVER_HTTP_ADDR=127.0.0.1:8080
SERVER_LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- daemon ----
# Pairing token issued per runtime by the backend. Placeholder only.
DAEMON_PAIRING_TOKEN=replace-me-with-a-runtime-pairing-token
DAEMON_SERVER_URL=ws://127.0.0.1:8080/api/v1/daemon
DAEMON_WORKSPACE_ROOT=./workspaces

# ---- web ----
# Leave unset for local dev: apps/web falls back to its own origin, which is
# where the T07 mock backend (apps/web/src/app/api/v1/**) lives. Set this
# once T05 (server/internal/{auth,org}) is up and the mock is removed - the
# web production build requires it (see docs/adr/ADR-007-web-ships-no-backend.md).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
