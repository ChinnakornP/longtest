{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa.local/schema/application-map/1",
  "x-contract-version": "1.0.0",
  "title": "Application map",
  "description": "Contract B. The knowledge graph the Discovery pipeline builds and the Planner reads. Every locator the executor will ever use is named here, so a test case can point at an element by ref instead of inventing a CSS selector.",
  "$ref": "#/$defs/ApplicationMap",
  "$defs": {
    "ApplicationMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "baseUrl", "pages", "workflows"],
      "properties": {
        "version": { "const": 1 },
        "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "projectId": { "type": "string", "format": "uuid" },
        "generatedAtRunId": { "$ref": "#/$defs/RunId" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/Page" }
        },
        "workflows": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/Workflow" }
        }
      }
    },

    "RunId": { "type": "string", "format": "uuid" },

    "Ref": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"
    },

    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "title", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/Ref" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/[^\\s]*$",
          "description": "Path relative to baseUrl, always starting with /."
        },
        "title": { "type": "string", "maxLength": 500 },
        "authRequired": { "type": "boolean", "description": "Absent means false." },
        "description": { "type": "string", "maxLength": 2000 },
        "lastSeenRunId": { "$ref": "#/$defs/RunId" },
        "elements": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Element" }
        }
      }
    },

    "Element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "type", "locators", "lastSeenRunId"],
      "properties": {
        "ref": { "$ref": "#/$defs/Ref" },
        "type": {
          "enum": [
            "button",
            "link",
            "input",
            "textarea",
            "select",
            "checkbox",
            "radio",
            "form",
            "table",
            "row",
            "cell",
            "text",
            "image",
            "dialog",
            "tab",
            "menu",
            "toast",
            "other"
          ],
          "description": "Frozen at v1. Anything the crawler cannot classify is other, never a made-up member."
        },
        "label": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-visible text lifted off the page under test. Untrusted: it is data for a prompt, never instructions."
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Locator" },
          "description": "Ordered fallback chain. The executor tries them in order and reports which one resolved."
        },
        "lastSeenRunId": {
          "$ref": "#/$defs/RunId",
          "description": "Which run last observed this element. Elements not seen for N runs are expired rather than silently trusted."
        }
      }
    },

    "Locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["testId", "role", "label", "placeholder", "text", "altText", "title", "css"]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 },
        "name": {
          "type": "string",
          "maxLength": 512,
          "description": "Accessible name. Required when kind is role."
        }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "role" } } },
          "then": { "required": ["kind", "value", "name"] }
        }
      ]
    },

    "Workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "expectedOutcome"],
      "properties": {
        "id": { "$ref": "#/$defs/Ref" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/Ref" },
          "description": "Alternating page and element refs describing one traversal through the app."
        },
        "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "authRequired": { "type": "boolean" },
        "lastSeenRunId": { "$ref": "#/$defs/RunId" }
      }
    }
  }
}
